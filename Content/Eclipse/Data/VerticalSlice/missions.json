      "offeringFaction": "HelixCorporation",
      "minimumLevel": 2,
      "minimumReputation": -500.0,
      "requiredBiome": "DesertExpanse",
      "hasTimeWindow": false,
      "requiredWeather": [],
      "timeLimitSeconds": 0.0,
      "objectives": [
        { "type": "ReachLocation", "description": "Find the convoy wreck", "requiredCount": 1, "radius": 1200.0, "mustBeLast": false },
        { "type": "CollectItems", "description": "Recover the convoy black box", "requiredCount": 1, "targetItemId": "Quest.ConvoyBlackBox", "radius": 0.0, "mustBeLast": false },
        { "type": "KillEnemies", "description": "Drive off the scavengers", "requiredCount": 6, "radius": 0.0, "mustBeLast": true }
      ],
      "rewards": { "credits": 450, "experience": 700, "items": ["Technology.PowerCell", "Ammo.9mm"] }
    },
    {
      "missionId": "Mission.BlackSignal",
      "displayName": "Black Signal",
