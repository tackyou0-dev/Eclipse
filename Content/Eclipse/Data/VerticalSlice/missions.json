      "missionType": "MainMission",
      "offeringFaction": "FreeColonists",
      "minimumLevel": 1,
      "minimumReputation": -1000.0,
      "requiredBiome": "None",
      "hasTimeWindow": false,
      "requiredWeather": [],
      "timeLimitSeconds": 0.0,
      "objectives": [
        { "type": "ReachLocation", "description": "Reach the Free Colonist camp", "requiredCount": 1, "radius": 900.0, "mustBeLast": false },
        { "type": "KillEnemies", "description": "Clear the drones around the camp", "requiredCount": 4, "radius": 0.0, "mustBeLast": false },
        { "type": "Interact", "description": "Speak with the camp quartermaster", "requiredCount": 1, "radius": 400.0, "mustBeLast": true }
      ],
      "rewards": { "credits": 250, "experience": 400, "items": ["Medical.Medkit", "Ammo.556"] }
    },
    {
