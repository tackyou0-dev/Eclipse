      "hasTimeWindow": false,
      "requiredWeather": ["ElectromagneticStorm"],
      "timeLimitSeconds": 0.0,
      "objectives": [
        { "type": "ReachLocation", "description": "Reach the crash zone transmitter", "requiredCount": 1, "radius": 800.0, "mustBeLast": false },
        { "type": "Survive", "description": "Hold position while the signal resolves", "requiredCount": 1, "durationSeconds": 90.0, "radius": 0.0, "mustBeLast": false },
        { "type": "KillEnemies", "description": "Destroy the guardian drones", "requiredCount": 5, "radius": 0.0, "mustBeLast": true }
      ],
      "rewards": { "credits": 700, "experience": 1100, "items": ["Technology.RelayModule", "Artifact.AlienRelic"] }
    },
    {
      "missionId": "Mission.BrokenRelay",
      "displayName": "Broken Relay",
      "briefing": "The colony relay network has been dark for 37 years. Bring a relay module to the tower on the frozen plateau and restore the link. The Iron Wolves want the tower for themselves.",
