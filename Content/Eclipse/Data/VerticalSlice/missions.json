      "timeWindowStartHour": 6.0,
      "timeWindowEndHour": 20.0,
      "requiredWeather": [],
      "timeLimitSeconds": 900.0,
      "objectives": [
        { "type": "ReachLocation", "description": "Reach the relay tower", "requiredCount": 1, "radius": 700.0, "mustBeLast": false },
        { "type": "Interact", "description": "Install the relay module", "requiredCount": 1, "radius": 300.0, "mustBeLast": false },
        { "type": "Survive", "description": "Defend the tower until the link is stable", "requiredCount": 1, "durationSeconds": 180.0, "radius": 0.0, "mustBeLast": true }
      ],
      "rewards": { "credits": 1000, "experience": 1600, "items": ["Armor.HazmatSuit", "Technology.PowerCell", "Medical.StimShot"] }
    },
    {
      "missionId": "Mission.TheWarden",
      "displayName": "The Warden",
      "briefing": "The black signal was a containment beacon, and you have just answered it. WARDEN PRIME is awake. Descend into the arena, break its four phases, and end the colony's long silence.",
