      "requiredBiome": "UndergroundComplex",
      "hasTimeWindow": false,
      "requiredWeather": [],
      "timeLimitSeconds": 0.0,
      "objectives": [
        { "type": "ReachLocation", "description": "Enter the Warden containment arena", "requiredCount": 1, "radius": 900.0, "mustBeLast": false },
        { "type": "KillEnemies", "description": "Defeat WARDEN PRIME", "requiredCount": 1, "radius": 0.0, "mustBeLast": false },
        { "type": "Extract", "description": "Reach the extraction zone with the Warden key", "requiredCount": 1, "targetItemId": "Quest.WardenKey", "radius": 600.0, "mustBeLast": true }
      ],
      "rewards": { "credits": 3000, "experience": 5000, "items": ["Attachment.PowerCore.Overcharge", "Artifact.AlienRelic"] }
